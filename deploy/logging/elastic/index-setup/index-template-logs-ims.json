{
  "_meta": {
    "description": "IMS platform logs (Fluent Bit -> Kafka -> Logstash), data stream logs-ims-default",
    "managed_by": "deploy/logging/elastic/index-setup"
  },
  "index_patterns": [
    "logs-ims-*"
  ],
  "data_stream": {},
  "priority": 200,
  "composed_of": [
    "logs@mappings",
    "logs@settings",
    "ecs@mappings"
  ],
  "template": {
    "settings": {
      "index": {
        "number_of_replicas": 0,
        "lifecycle": {
          "name": "logs-ims"
        }
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date_nanos"
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            },
            "logger": {
              "type": "keyword"
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            },
            "instance": {
              "properties": {
                "id": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "sip": {
          "properties": {
            "call_id": {
              "type": "keyword"
            },
            "method": {
              "type": "keyword"
            },
            "direction": {
              "type": "keyword"
            },
            "summary": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "cseq": {
              "type": "keyword"
            },
            "request_uri": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "status_code": {
              "type": "short"
            },
            "message": {
              "type": "match_only_text"
            }
          }
        },
        "kubernetes": {
          "properties": {
            "labels": {
              "type": "flattened"
            }
          }
        },
        "event": {
          "properties": {
            "action": {
              "type": "keyword"
            }
          }
        },
        "source": {
          "properties": {
            "address": {
              "type": "keyword"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "destination": {
          "properties": {
            "address": {
              "type": "keyword"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
