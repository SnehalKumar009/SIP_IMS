<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================================================================== -->
    <!-- shared-telecom-lib                                                   -->
    <!-- Reusable Jain SIP lifecycle wrapper, HEPv3 (Homer) encoder/shipper,  -->
    <!-- and Micrometer metric interceptors. Plain library jar (NOT a boot    -->
    <!-- app) consumed by every CSCF / HSS / CDF pod.                         -->
    <!-- ==================================================================== -->

    <parent>
        <groupId>com.snehal.ims</groupId>
        <artifactId>ims-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>shared-telecom-lib</artifactId>
    <name>shared-telecom-lib</name>
    <description>Jain SIP lifecycle, HEPv3 capture, and metrics primitives shared across IMS pods</description>

    <dependencies>
        <!-- Spring context/config for @Configuration factories and @ConfigurationProperties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Embedded servlet container that serves the Actuator/Prometheus HTTP
             endpoints (K8s liveness/readiness probes + ServiceMonitor scrape). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator + Micrometer Prometheus registry (exposed by every pod) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Jain SIP API (JSR-32 interfaces) + NIST RI -->
        <dependency>
            <groupId>javax.sip</groupId>
            <artifactId>jain-sip-api</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.sip</groupId>
            <artifactId>jain-sip-ri</artifactId>
        </dependency>

        <!-- NIST stack hard-references org.apache.log4j.* at init; this bridge supplies
             those classes and routes NIST logging into SLF4J/logback (no log4j 1.x). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
        </dependency>

        <!-- JSON structured logging encoder -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- ==== test ==== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Library jar: do NOT repackage as an executable boot jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
