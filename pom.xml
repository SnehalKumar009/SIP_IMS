<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================================================================== -->
    <!-- IMS SIP Platform :: Reactor / Parent POM                             -->
    <!-- Aggregates all shared libraries (platform/*) and deployable pods     -->
    <!-- (services/*). Owns the single source of dependency + plugin versions.-->
    <!-- ==================================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/> <!-- resolve from Maven repo -->
    </parent>

    <groupId>com.snehal.ims</groupId>
    <artifactId>ims-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>IMS SIP Platform</name>
    <description>Production-grade containerized IMS SIP platform (CSCF / HSS / CDF)</description>

    <modules>
        <module>platform/shared-telecom-lib</module>
        <module>services/p-cscf</module>
        <module>services/hss</module>
        <module>services/i-cscf</module>
        <module>services/s-cscf</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ==== Dependency versions (single source of truth) ==== -->
        <jain-sip-api.version>1.2.1.4</jain-sip-api.version>
        <jain-sip-ri.version>1.3.0-91</jain-sip-ri.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <grpc.version>1.66.0</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <grpc-spring.version>3.1.0.RELEASE</grpc-spring.version>
        <logstash-logback.version>7.4</logstash-logback.version>

        <!-- ==== Plugin versions ==== -->
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jain SIP API (JSR-32 interfaces: javax.sip.*) -->
            <dependency>
                <groupId>javax.sip</groupId>
                <artifactId>jain-sip-api</artifactId>
                <version>${jain-sip-api.version}</version>
            </dependency>

            <!-- Jain SIP (NIST reference implementation, JSR-32) -->
            <dependency>
                <groupId>javax.sip</groupId>
                <artifactId>jain-sip-ri</artifactId>
                <version>${jain-sip-ri.version}</version>
            </dependency>

            <!-- Resilience4j (circuit breaker / bulkhead / retry) -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Bucket4j (token-bucket rate limiting, used by P-CSCF) -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- Structured JSON logging -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>

            <!-- gRPC BOM (Cx interface, used by HSS / I-CSCF / S-CSCF) -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- protobuf-java pinned to the protoc used for code generation -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Spring Boot 3 integration for gRPC server (@GrpcService, actuator health) -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-server-spring-boot-starter</artifactId>
                <version>${grpc-spring.version}</version>
            </dependency>

            <!-- Spring Boot 3 integration for gRPC client (@GrpcClient, used by the I-CSCF Cx client) -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-client-spring-boot-starter</artifactId>
                <version>${grpc-spring.version}</version>
            </dependency>

            <!-- Supplies javax.annotation.Generated referenced by protoc-generated stubs -->
            <dependency>
                <groupId>javax.annotation</groupId>
                <artifactId>javax.annotation-api</artifactId>
                <version>1.3.2</version>
            </dependency>

            <!-- Internal shared libraries -->
            <dependency>
                <groupId>com.snehal.ims</groupId>
                <artifactId>shared-telecom-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <!-- protoc + grpc code generation (HSS and future CSCF Cx clients) -->
                <plugin>
                    <groupId>org.xolstice.maven.plugins</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
